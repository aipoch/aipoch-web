{
  "name": "aipoch-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --port 3202",
    "dev:mock": "bun run scripts/dev-mock.ts",
    "test:mock": "bun test ./tests/integration/mock-development.test.ts",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "test:unit": "bun test --isolate ./tests/unit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "bun --bun next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check . --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.3.1",
    "@tanstack/react-query": "^5.90.20",
    "ahooks": "^3.9.6",
    "axios": "^1.13.4",
    "canvas-confetti": "^1.9.4",
    "clipboard-copy": "^4.0.1",
    "fast-xml-parser": "^5.11.0",
    "gray-matter": "^4.0.3",
    "motion": "^12.42.2",
    "next": "16.1.6",
    "next-mdx-remote-client": "^2.1.7",
    "next-runtime-env": "^3.3.0",
    "nextjs-toploader": "^3.9.17",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "rehype-slug": "^6.0.0",
    "remark-flexible-toc": "^1.2.4",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@mswjs/http-middleware": "^0.10.3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.3.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "msw": "^2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "packageManager": "bun@1.3.14"
}
